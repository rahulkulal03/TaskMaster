rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }
    
    // ===============================================================
    // Domain Validators
    // ===============================================================
    
    function isValidTask(data) {
      return hasOnlyAllowedFields(['id', 'uid', 'title', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.createdAt is string; // ISO string
    }
    
    function isValidCompletion(data) {
      return hasOnlyAllowedFields(['id', 'uid', 'taskId', 'date', 'completed']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 150 &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.taskId is string && data.taskId.size() > 0 && data.taskId.size() < 100 &&
             data.date is string && data.date.size() == 10 && // YYYY-MM-DD
             data.completed is bool;
    }

    function isValidReminder(data) {
      let allowedFields = ['id', 'uid', 'text', 'date', 'time', 'completed', 'notified'];
      return request.resource.data.keys().hasOnly(allowedFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 500 &&
             data.date is string && data.date.size() == 10 && // YYYY-MM-DD
             data.time is string && data.time.size() == 5 && // HH:mm
             data.completed is bool &&
             (!('notified' in data) || data.notified is bool);
    }

    function isValidProfileSettings(data) {
      let allowedFields = ['photoUrl', 'language', 'biometricEnabled', 'alarmSound'];
      return request.resource.data.keys().hasOnly(allowedFields) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 1048576)) && // 1MB limit for base64 image
             (!('language' in data) || (data.language is string && data.language.size() < 10)) &&
             (!('biometricEnabled' in data) || data.biometricEnabled is bool) &&
             (!('alarmSound' in data) || (data.alarmSound is string && data.alarmSound.size() < 50));
    }

    function isValidUser(data) {
      let allowedFields = ['uid', 'email', 'displayName', 'photoURL', 'isAnonymous', 'createdAt', 'lastLogin', 'dob'];
      return request.resource.data.keys().hasOnly(allowedFields) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             (!('email' in data) || (data.email is string && data.email.size() < 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 200)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1048576)) &&
             (!('isAnonymous' in data) || data.isAnonymous is bool) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('lastLogin' in data) || data.lastLogin is string) &&
             (!('dob' in data) || (data.dob is string && data.dob.size() <= 15));
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      isValidTask(request.resource.data) && 
                      uidUnchanged();
        allow update: if isOwner(userId) && 
                      isValidTask(request.resource.data) && 
                      uidNotModified() &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }
      
      match /completions/{completionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      isValidCompletion(request.resource.data) && 
                      uidUnchanged();
        allow update: if isOwner(userId) && 
                      isValidCompletion(request.resource.data) && 
                      uidNotModified() &&
                      request.resource.data.taskId == resource.data.taskId &&
                      request.resource.data.date == resource.data.date;
        allow delete: if isOwner(userId);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      isValidReminder(request.resource.data) && 
                      uidUnchanged();
        allow update: if isOwner(userId) && 
                      isValidReminder(request.resource.data) && 
                      uidNotModified();
        allow delete: if isOwner(userId);
      }

      match /settings/{document} {
        allow read: if isOwner(userId) && document == 'profile';
        allow create: if isOwner(userId) && document == 'profile' && isValidProfileSettings(request.resource.data);
        allow update: if isOwner(userId) && document == 'profile' && isValidProfileSettings(request.resource.data);
        allow delete: if isOwner(userId) && document == 'profile';
      }
    }
  }
}
